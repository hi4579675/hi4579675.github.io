---
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname;
---
<nav>
  <a href="/" class="logo">hanna<span>.log</span></a>
  <div class="nav-links">
    <a href="/" class={path === '/' ? 'active' : ''}>home</a>
    <a href="/about/" class={path.startsWith('/about') ? 'active' : ''}>about</a>
    <a href="/blog/" class={path.startsWith('/blog') ? 'active' : ''}>blog</a>
    <a href="/portfolio/" class={path.startsWith('/portfolio') ? 'active' : ''}>portfolio</a>
  </div>
  <ThemeToggle />
</nav>

<style>
  nav { background: #090b14; border-bottom: 1px solid #1e2340; padding: 0 2.5rem; height: 52px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 100; }
  .logo { font-family: 'JetBrains Mono', monospace; font-size: 15px; color: #82aaff; font-weight: 500; letter-spacing: .06em; text-decoration: none; }
  .logo span { color: #c099ff; }
  .nav-links { display: flex; gap: 2rem; }
  .nav-links a { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #444b6a; text-decoration: none; letter-spacing: .05em; transition: color .15s; }
  .nav-links a:hover, .nav-links a.active { color: #82aaff; }

  :global(html[data-theme="light"]) nav { background: #ffffff; border-bottom-color: #dfe2ef; }
  :global(html[data-theme="light"]) .logo { color: #2e6ff2; }
  :global(html[data-theme="light"]) .logo span { color: #7c3aed; }
  :global(html[data-theme="light"]) .nav-links a { color: #9599b3; }
  :global(html[data-theme="light"]) .nav-links a:hover,
  :global(html[data-theme="light"]) .nav-links a.active { color: #2e6ff2; }
</style>
