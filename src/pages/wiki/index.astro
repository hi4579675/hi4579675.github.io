---
import Header from '../../components/Header.astro';
import { getCollection } from 'astro:content';
import { wikiGroups, wikiTopicMap } from '../../data/wikiTopics';

const notes = await getCollection('docs', (e) => e.id.startsWith('wiki/'));

const countByTopic: Record<string, number> = {};
for (const n of notes) {
  const t = (n.data as any).category ?? 'etc';
  countByTopic[t] = (countByTopic[t] ?? 0) + 1;
}

const notesByTopic: Record<string, typeof notes> = {};
for (const n of notes) {
  const t = (n.data as any).category ?? 'etc';
  (notesByTopic[t] ??= []).push(n);
}
for (const t of Object.keys(notesByTopic)) {
  notesByTopic[t].sort((a, b) => a.data.title.localeCompare(b.data.title, 'ko'));
}

const activeTopicCount = Object.keys(countByTopic).length;
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>wiki — hanna.log</title>
  <meta name="description" content="개념을 주제별로 정리해 두는 개인 위키." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Sans+KR:wght@400;500&display=swap" rel="stylesheet" />
  <script is:inline>(function(){var t=localStorage.getItem('theme');if(t){document.documentElement.setAttribute('data-theme',t)}else{document.documentElement.setAttribute('data-theme','light')}})()</script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { background: #0d0f1a; }
    html[data-theme='light'] { background: #f8f9fc; }
    body { font-family: 'JetBrains Mono', 'Noto Sans KR', sans-serif; background: transparent; color: #c8d3f5; min-height: 100vh; }

    main { max-width: 880px; margin: 0 auto; padding: 0 2.5rem 5rem; }

    .masthead { padding: 3rem 0 1.6rem; border-bottom: 1px solid #1e2340; }
    .mast-kicker { font-size: 13px; font-weight: 400; color: #636d94; letter-spacing: .1em; text-transform: uppercase; margin-bottom: .6rem; }
    .mast-title { font-size: 32px; font-weight: 500; color: #c8d3f5; line-height: 1.2; }
    .mast-desc { font-size: 13px; color: #636d94; font-family: 'Noto Sans KR', sans-serif; line-height: 1.7; margin-top: .7rem; }
    .mast-meta { display: flex; gap: 1.1rem; margin-top: 1.1rem; font-size: 11px; color: #444b6a; letter-spacing: .04em; flex-wrap: wrap; }
    .mast-meta b { color: #86e1fc; font-weight: 500; }

    .group { margin-top: 2.6rem; }
    .group-label { font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: #444b6a; margin-bottom: .9rem; padding-left: .15rem; }
    .card-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }

    .cat-card {
      display: block; text-decoration: none;
      background: #0f1120; border: 1px solid #1a1f38; border-radius: 12px;
      padding: 1.3rem 1.4rem; transition: border-color .18s, transform .15s, background .18s;
    }
    .cat-card:hover { border-color: #2d3561; transform: translateY(-2px); }
    .cat-head { display: flex; align-items: baseline; justify-content: space-between; gap: .6rem; margin-bottom: .8rem; }
    .cat-name { font-family: 'JetBrains Mono', monospace; font-size: 17px; font-weight: 500; color: #c8d3f5; letter-spacing: .02em; }
    .cat-count { font-size: 11px; color: #444b6a; letter-spacing: .04em; white-space: nowrap; }
    .cat-card:hover .cat-name { color: #82aaff; }
    .cat-notes { list-style: none; display: flex; flex-direction: column; gap: .32rem; }
    .cat-note { font-family: 'Noto Sans KR', sans-serif; font-size: 12.5px; color: #636d94; line-height: 1.5; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cat-note::before { content: '·'; color: #2d3561; margin-right: .45rem; }
    .cat-more { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #444b6a; margin-top: .5rem; }

    footer { margin-top: 5rem; border-top: 1px solid #1e2340; padding: 1.5rem 2.5rem; text-align: center; font-size: 11px; color: #444b6a; letter-spacing: .08em; }

    @media (max-width: 680px) {
      main { padding: 0 1.4rem 4rem; }
      .card-grid { grid-template-columns: 1fr; }
    }

    /* light mode */
    [data-theme='light'] body { color: #1e2030; }
    [data-theme='light'] .masthead { border-bottom-color: #dfe2ef; }
    [data-theme='light'] .mast-kicker { color: #9599b3; }
    [data-theme='light'] .mast-title { color: #1e2030; }
    [data-theme='light'] .mast-desc { color: #6e7491; }
    [data-theme='light'] .mast-meta { color: #bcc1d4; }
    [data-theme='light'] .mast-meta b { color: #2e6ff2; }
    [data-theme='light'] .group-label { color: #bcc1d4; }
    [data-theme='light'] .cat-card { background: #ffffff; border-color: #e7e9f2; }
    [data-theme='light'] .cat-card:hover { border-color: #c7ccdd; }
    [data-theme='light'] .cat-name { color: #1e2030; }
    [data-theme='light'] .cat-card:hover .cat-name { color: #2e6ff2; }
    [data-theme='light'] .cat-count { color: #bcc1d4; }
    [data-theme='light'] .cat-note { color: #6e7491; }
    [data-theme='light'] .cat-note::before { color: #c7ccdd; }
    [data-theme='light'] .cat-more { color: #bcc1d4; }
    [data-theme='light'] footer { border-top-color: #dfe2ef; color: #bcc1d4; }
  </style>
</head>
<body>

<Header />

<main>
  <div class="masthead">
    <p class="mast-kicker">hanna.log / wiki</p>
    <h1 class="mast-title">개념을 주제별로 정리합니다</h1>
    <p class="mast-desc">blog가 "그때 무엇을 했나"의 기록이라면, wiki는 "이 개념이 무엇인가"를 주제별로 모아 두는 개인 위키입니다. 카테고리를 골라 들어가세요.</p>
    <div class="mast-meta">
      <span><b>{notes.length}</b> notes</span>
      <span><b>{activeTopicCount}</b> topics</span>
    </div>
  </div>

  {wikiGroups.map(({ label, topics }) => {
    const visible = topics.filter((t) => (countByTopic[t.id] ?? 0) > 0);
    return visible.length === 0 ? null : (
      <div class="group">
        <div class="group-label">{label}</div>
        <div class="card-grid">
          {visible.map(({ id, display }) => {
            const list = notesByTopic[id] ?? [];
            const preview = list.slice(0, 4);
            const rest = list.length - preview.length;
            return (
              <a class="cat-card" href={`/wiki/category/${id}/`}>
                <div class="cat-head">
                  <span class="cat-name">{display}</span>
                  <span class="cat-count">{list.length} notes</span>
                </div>
                <ul class="cat-notes">
                  {preview.map((n) => <li class="cat-note">{n.data.title}</li>)}
                </ul>
                {rest > 0 && <div class="cat-more">+{rest} more →</div>}
              </a>
            );
          })}
        </div>
      </div>
    );
  })}
</main>

<footer>© 2026 hanna.log · Built with Astro & Starlight</footer>

</body>
</html>
