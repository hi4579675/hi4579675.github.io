</main>

<!-- MODAL -->
<div class="modal-overlay" id="modal-overlay">
  <div class="modal" id="modal-panel">
    <button class="modal-close" id="modal-close" aria-label="닫기">✕</button>
    <div class="modal-header">
      <img class="modal-img" id="modal-img" src="" alt="" />
      <div class="modal-title-wrap">
        <h2 class="modal-title" id="modal-title"></h2>
        <p class="modal-subtitle" id="modal-subtitle"></p>
        <div class="modal-tags" id="modal-tags"></div>
        <a class="modal-github-btn" id="modal-github" href="" target="_blank" rel="noopener">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.085 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12"/></svg>
          GitHub
        </a>
      </div>
    </div>
    <div class="modal-body">
      <section class="modal-section">
        <h3 class="modal-section-title">프로젝트 개요</h3>
        <p class="modal-text" id="modal-overview"></p>
      </section>
      <section class="modal-section">
        <h3 class="modal-section-title">내가 맡은 역할</h3>
        <ul class="modal-list" id="modal-role"></ul>
      </section>
      <section class="modal-section">
        <h3 class="modal-section-title">어려웠던 점</h3>
        <p class="modal-text" id="modal-challenge"></p>
      </section>
      <section class="modal-section">
        <h3 class="modal-section-title">해결 방법</h3>
        <p class="modal-text" id="modal-solution"></p>
      </section>
    </div>
  </div>
</div>

<footer>© 2026 hanna.log · Built with Astro & Starlight</footer>

<script>
