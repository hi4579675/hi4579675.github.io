---
import Header from '../../components/Header.astro';
import { getCollection } from 'astro:content';

const allDocs = await getCollection('docs', (e) => e.id.startsWith('blog/'));
const posts = allDocs.filter((p) => p.data.date);

type CatDef = { id: string; display: string; desc: string; color: string };
type Group  = { label: string; cats: CatDef[] };

const groups: Group[] = [
  {
    label: 'project',
    cats: [
      { id: 'ticketing', display: 'ticketing', desc: '오픈런 트래픽을 견디는 단일 구단 티켓팅 백엔드 시스템.', color: '#ff757f' },
    ],
  },
  {
    label: 'topic',
    cats: [
      { id: 'develops',        display: 'dev',             desc: '프로젝트 회고, 기술 선택 이유, 구현 상세.',           color: '#86e1fc' },
      { id: 'troubleshooting', display: 'troubleshooting', desc: '마주친 버그와 에러, 원인 분석과 해결 과정.',          color: '#ffc777' },
      { id: 'performance',     display: 'performance',     desc: '쿼리 최적화, 캐싱, 부하 테스트 등 성능 개선 경험.',   color: '#c3e88d' },
      { id: 'architecture',    display: 'architecture',    desc: '시스템 설계, MSA, 비동기 패턴 등 아키텍처 결정.',     color: '#82aaff' },
    ],
  },
  {
    label: 'stack',
    cats: [
      { id: 'redis', display: 'redis',    desc: 'Redis 자료구조, 패턴, 실전 적용 사례.',              color: '#ff757f' },
      { id: 'ai',    display: 'ai · llm', desc: 'LLM·RAG·임베딩 등 생성형 AI 파이프라인 설계와 실험.', color: '#c099ff' },
    ],
  },
];

const countByCat: Record<string, number> = {};
for (const post of posts) {
  const cat: string = (post.data as any).category ?? 'develops';
  countByCat[cat] = (countByCat[cat] ?? 0) + 1;
}
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>blog — hanna.log</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Sans+KR:wght@400;500&display=swap" rel="stylesheet" />
  <script is:inline>(function(){var t=localStorage.getItem('theme');if(t){document.documentElement.setAttribute('data-theme',t)}else{document.documentElement.setAttribute('data-theme','dark')}})()</script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { background: #0d0f1a; }
    html[data-theme='light'] { background: #f8f9fc; }
    body { font-family: 'JetBrains Mono', 'Noto Sans KR', sans-serif; background: transparent; color: #c8d3f5; min-height: 100vh; }


    main { max-width: 860px; margin: 0 auto; padding: 0 2.5rem 5rem; }

    .page-header { padding: 3rem 0 1.6rem; }
    .page-title { font-size: 13px; font-weight: 400; color: #636d94; letter-spacing: .1em; text-transform: uppercase; margin-bottom: .6rem; }
    .page-headline { font-size: 32px; font-weight: 500; color: #c8d3f5; line-height: 1.2; }
    .page-desc { font-size: 13px; color: #636d94; font-family: 'Noto Sans KR', sans-serif; line-height: 1.7; margin-top: .7rem; }

    .groups { display: flex; flex-direction: column; gap: 2rem; margin-top: 1.5rem; padding: 1.5rem 0; }

    .group-label { font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: #c8d3f5; margin-bottom: .7rem; }

    .cat-list { list-style: none; display: flex; flex-direction: column; gap: .45rem; }

    .cat-link {
      display: flex; align-items: center; justify-content: space-between;
      padding: .85rem 1.1rem;
      background: #0f1120; border: 1px solid #1a1f38; border-radius: 8px;
      text-decoration: none; gap: 1.2rem;
      transition: border-color .18s, background .18s;
    }
    .cat-link:hover { background: #111528; border-color: #2d3561; }

    .cat-info { flex: 1; min-width: 0; }
    .cat-name {
      font-family: 'JetBrains Mono', monospace; font-size: 14px;
      font-weight: 500; letter-spacing: .04em;
      display: block; transition: opacity .15s;
    }
    .cat-link:hover .cat-name { opacity: .75; }
    .cat-desc {
      font-family: 'Noto Sans KR', sans-serif; font-size: 12.5px;
      color: #636d94; margin-top: .25rem; line-height: 1.55;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .cat-count {
      font-family: 'JetBrains Mono', monospace; font-size: 12px;
      color: #444b6a; flex-shrink: 0; letter-spacing: .04em;
      min-width: 18px; text-align: right;
    }

    footer { margin-top: 5rem; border-top: 1px solid #1e2340; padding: 1.5rem 2.5rem; text-align: center; font-size: 11px; color: #444b6a; letter-spacing: .08em; }

    /* ── light mode ── */
    [data-theme='light'] body { color: #1e2030; }
    [data-theme='light'] nav { background: #ffffff; border-bottom-color: #dfe2ef; }
    [data-theme='light'] .logo { color: #2e6ff2; }
    [data-theme='light'] .logo span { color: #7c3aed; }
    [data-theme='light'] .nav-links a { color: #9599b3; }
    [data-theme='light'] .nav-links a:hover,
    [data-theme='light'] .nav-links a.active { color: #2e6ff2; }
    [data-theme='light'] .page-title { color: #9599b3; }
    [data-theme='light'] .page-headline { color: #1e2030; }
    [data-theme='light'] .page-desc { color: #6e7491; }
    [data-theme='light'] .group-label { color: #1e2030; }
    [data-theme='light'] .cat-link { background: #ffffff; border-color: #dfe2ef; }
    [data-theme='light'] .cat-link:hover { background: #f0f2f7; border-color: #bcc1d4; }
    [data-theme='light'] .cat-desc { color: #6e7491; }
    [data-theme='light'] .cat-count { color: #bcc1d4; }
    [data-theme='light'] footer { border-top-color: #dfe2ef; color: #bcc1d4; }
  </style>
</head>
<body>

<Header />

<main>
  <div class="page-header">
    <p class="page-title">hanna.log</p>
    <h1 class="page-headline">Blog</h1>
    <p class="page-desc">백엔드 개발과 생성형 AI 파이프라인 경험을 기록합니다.</p>
  </div>

  <div class="groups">
    {groups.map(({ label, cats }) => (
      <section>
        <div class="group-label">{label}</div>
        <ul class="cat-list">
          {cats.map(({ id, display, desc, color }) => (
            <li>
              <a href={`/blog/category/${id}/`} class="cat-link">
                <div class="cat-info">
                  <span class="cat-name" style={`color:${color};`}>{display}</span>
                  <span class="cat-desc">{desc}</span>
                </div>
                <span class="cat-count">{countByCat[id] ?? 0}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</main>

<footer>© 2026 hanna.log · Built with Astro & Starlight</footer>

</body>
</html>
