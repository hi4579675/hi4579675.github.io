---
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';

const allDocs = await getCollection('docs', (e) => e.id.startsWith('blog/'));
const posts = allDocs
  .filter((p) => p.data.date)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

type CatDef = { id: string; display: string };
const groups: { cats: CatDef[] }[] = [
  { cats: [ { id: 'ticketing', display: 'ticketing' }, { id: 'nolleo-onna', display: 'nolleo-onna' } ] },
  { cats: [ { id: 'develops', display: 'dev' }, { id: 'troubleshooting', display: 'troubleshooting' }, { id: 'performance', display: 'performance' }, { id: 'architecture', display: 'architecture' } ] },
];
const allCats: CatDef[] = groups.flatMap((g) => g.cats);

const countByCat: Record<string, number> = {};
for (const post of posts) {
  const cat: string = (post.data as any).category ?? 'develops';
  countByCat[cat] = (countByCat[cat] ?? 0) + 1;
}
const chips = allCats.filter((c) => (countByCat[c.id] ?? 0) > 0);

const tagColor: Record<string, string> = {
  Redis: 'tp', 'Spring Boot': 'tb', '분산락': 'tb',
  LangChain: 'tv', Pinecone: 'tc', JPA: 'tb', QueryDSL: 'tg',
  MSA: 'tc', Kafka: 'tv', OpenAI: 'tv', RateLimit: 'to',
  '동시성': 'tp', '시스템 설계': 'tc', RAG: 'tv', LLM: 'tv',
  JWT: 'tb', FastAPI: 'tv',
};

const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth()+1).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')}`;
const latestDate = posts[0] ? new Date(posts[0].data.date) : null;
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>hanna.log — 백엔드 기술 노트</title>
  <meta name="description" content="신입 백엔드 개발자가 공부한 것과 마주친 문제·해결 과정을 기록하는 개인 기술 블로그." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Sans+KR:wght@400;500&display=swap" rel="stylesheet" />
  <script is:inline>(function(){var t=localStorage.getItem('theme');if(t){document.documentElement.setAttribute('data-theme',t)}else{document.documentElement.setAttribute('data-theme','light')}})()</script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { background: #0d0f1a; }
    html[data-theme='light'] { background: #f8f9fc; }
    body { font-family: 'JetBrains Mono', 'Noto Sans KR', sans-serif; background: transparent; color: #c8d3f5; min-height: 100vh; }

    main { max-width: 800px; margin: 0 auto; padding: 0 2rem 5rem; }

    /* masthead */
    .masthead { padding: 3.5rem 0 1.4rem; }
    .mast-kicker { font-size: 13px; color: #636d94; letter-spacing: .1em; text-transform: uppercase; margin-bottom: .6rem; }
    .mast-title { font-size: 34px; font-weight: 500; color: #c8d3f5; line-height: 1.2; }
    .mast-desc { font-size: 14px; color: #636d94; font-family: 'Noto Sans KR', sans-serif; line-height: 1.7; margin-top: .8rem; max-width: 540px; }
    .mast-meta { display: flex; gap: 1.1rem; margin-top: 1.1rem; font-size: 11px; color: #444b6a; letter-spacing: .04em; flex-wrap: wrap; }
    .mast-meta b { color: #86e1fc; font-weight: 500; }

    /* category chips */
    .chips { display: flex; flex-wrap: wrap; gap: .5rem; padding: 1.4rem 0 2rem; border-top: 1px solid #1e2340; margin-top: 1.6rem; }
    .chip { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: .02em; padding: .4rem .85rem; border-radius: 999px; cursor: pointer; background: #0f1120; border: 1px solid #1a1f38; color: #8a93b8; user-select: none; transition: border-color .15s, background .15s, color .15s; }
    .chip:hover { border-color: #2d3561; color: #c8d3f5; }
    .chip.active { background: #1a2142; border-color: #82aaff; color: #c8d3f5; }
    .chip .c-num { color: #444b6a; margin-left: .35rem; font-size: 11px; }
    .chip.active .c-num { color: #82aaff; }

    /* post cards */
    .feed { display: flex; flex-direction: column; gap: 1rem; }
    .post-card { background: #0f1120; border: 1px solid #1a1f38; border-radius: 12px; padding: 1.4rem 1.6rem; transition: border-color .18s, transform .15s; }
    .post-card:hover { border-color: #2d3561; transform: translateY(-2px); }
    .card-meta { display: flex; align-items: center; gap: .6rem; margin-bottom: .55rem; }
    .card-cat { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .04em; color: #636d94; text-decoration: none; }
    .card-cat:hover { color: #82aaff; }
    .card-new { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: .08em; text-transform: uppercase; color: #c3e88d; border: 1px solid rgba(195,232,141,.3); border-radius: 4px; padding: 1px 6px; }
    .card-date { font-size: 11px; color: #444b6a; letter-spacing: .05em; }
    .card-title { display: block; font-family: 'Noto Sans KR', sans-serif; font-size: 16px; font-weight: 500; color: #c8d3f5; text-decoration: none; line-height: 1.45; transition: color .15s; }
    .card-title:hover { color: #82aaff; }
    .card-excerpt { margin-top: .5rem; font-size: 13px; color: #636d94; font-family: 'Noto Sans KR', sans-serif; line-height: 1.7; }
    .card-tags { display: flex; gap: 5px; margin-top: .8rem; flex-wrap: wrap; }
    .tag { font-size: 10px; padding: 2px 9px; border-radius: 4px; letter-spacing: .03em; }
    .tb { background: rgba(130,170,255,.1);  color: #82aaff; border: 1px solid rgba(130,170,255,.2); }
    .tv { background: rgba(192,153,255,.1);  color: #c099ff; border: 1px solid rgba(192,153,255,.2); }
    .tc { background: rgba(134,225,252,.09); color: #86e1fc; border: 1px solid rgba(134,225,252,.18); }
    .tg { background: rgba(195,232,141,.09); color: #c3e88d; border: 1px solid rgba(195,232,141,.18); }
    .to { background: rgba(255,199,119,.09); color: #ffc777; border: 1px solid rgba(255,199,119,.18); }
    .tp { background: rgba(255,117,127,.09); color: #ff757f; border: 1px solid rgba(255,117,127,.18); }

    /* featured (최신글) */
    .post-card.featured { background: linear-gradient(180deg, #11142a 0%, #0f1120 100%); border-color: #232a4d; padding: 1.8rem 1.9rem; }
    .post-card.featured .card-title { font-size: 22px; line-height: 1.35; }
    .post-card.featured .card-excerpt { font-size: 14px; }

    .empty { padding: 3rem 0; font-size: 13px; color: #2e3455; font-family: 'Noto Sans KR', sans-serif; text-align: center; }

    footer { margin-top: 5rem; border-top: 1px solid #1e2340; padding: 1.5rem 2.5rem; text-align: center; font-size: 11px; color: #444b6a; letter-spacing: .08em; }

    /* light mode */
    [data-theme='light'] body { color: #1e2030; }
    [data-theme='light'] .mast-kicker { color: #9599b3; }
    [data-theme='light'] .mast-title { color: #1e2030; }
    [data-theme='light'] .mast-desc { color: #6e7491; }
    [data-theme='light'] .mast-meta { color: #bcc1d4; }
    [data-theme='light'] .mast-meta b { color: #2e6ff2; }
    [data-theme='light'] .chips { border-top-color: #dfe2ef; }
    [data-theme='light'] .chip { background: #ffffff; border-color: #dfe2ef; color: #6e7491; }
    [data-theme='light'] .chip:hover { border-color: #bcc1d4; color: #1e2030; }
    [data-theme='light'] .chip.active { background: #eef1fb; border-color: #2e6ff2; color: #1e2030; }
    [data-theme='light'] .chip .c-num { color: #bcc1d4; }
    [data-theme='light'] .chip.active .c-num { color: #2e6ff2; }
    [data-theme='light'] .post-card { background: #ffffff; border-color: #e7e9f2; }
    [data-theme='light'] .post-card:hover { border-color: #c7ccdd; }
    [data-theme='light'] .post-card.featured { background: linear-gradient(180deg, #f3f6ff 0%, #ffffff 100%); border-color: #d8def0; }
    [data-theme='light'] .card-cat { color: #6e7491; }
    [data-theme='light'] .card-cat:hover { color: #2e6ff2; }
    [data-theme='light'] .card-date { color: #bcc1d4; }
    [data-theme='light'] .card-title { color: #1e2030; }
    [data-theme='light'] .card-title:hover { color: #2e6ff2; }
    [data-theme='light'] .card-excerpt { color: #6e7491; }
    [data-theme='light'] .empty { color: #bcc1d4; }
    [data-theme='light'] footer { border-top-color: #dfe2ef; color: #bcc1d4; }
  </style>
</head>
<body>

<Header />

<main>
  <div class="masthead">
    <p class="mast-kicker">hanna.log</p>
    <h1 class="mast-title">배우고 부딪힌 것을 정리합니다</h1>
    <p class="mast-desc">신입 백엔드 개발자가 더 나은 개발자가 되기 위해, 공부한 것과 마주친 문제·해결 과정을 기록합니다.</p>
    <div class="mast-meta">
      <span><b>{posts.length}</b> posts</span>
      {latestDate && <span>last updated <b>{fmt(latestDate)}</b></span>}
    </div>
  </div>

  <div class="chips">
    <span class="chip active" data-cat="all">all<span class="c-num">{posts.length}</span></span>
    {chips.map(({ id, display }) => (
      <span class="chip" data-cat={id}>{display}<span class="c-num">{countByCat[id] ?? 0}</span></span>
    ))}
  </div>

  <div class="feed" id="feed">
    {posts.map((post, i) => {
      const slug    = post.id.replace(/^blog\//, '');
      const cat     = (post.data as any).category ?? 'develops';
      const catDef  = allCats.find((c) => c.id === cat);
      const dateStr = fmt(new Date(post.data.date));
      const tags: string[] = (post.data.tags as string[]) ?? [];
      const searchText = `${post.data.title} ${post.data.excerpt ?? ''} ${tags.join(' ')} ${cat}`.toLowerCase();
      return (
        <article class={`post-card ${i === 0 ? 'featured' : ''}`} data-cat={cat} data-search={searchText}>
          <div class="card-meta">
            <a href={`/blog/category/${cat}/`} class="card-cat">{catDef?.display ?? cat}</a>
            {i === 0 && <span class="card-new">latest</span>}
            <span class="card-date">{dateStr}</span>
          </div>
          <a href={`/blog/${slug}/`} class="card-title">{post.data.title}</a>
          {post.data.excerpt && <p class="card-excerpt">{post.data.excerpt as string}</p>}
          {tags.length > 0 && (
            <div class="card-tags">
              {tags.map((tag) => <span class={`tag ${tagColor[tag] ?? 'tb'}`}>{tag}</span>)}
            </div>
          )}
        </article>
      );
    })}
  </div>
  <p class="empty" id="empty" style="display:none;">해당 카테고리에 글이 없습니다.</p>
</main>

<footer>© 2026 hanna.log · Built with Astro & Starlight</footer>

<script is:inline>
  (function () {
    var chips = document.querySelectorAll('.chip');
    var cards = document.querySelectorAll('.post-card');
    var empty = document.getElementById('empty');
    var cur = 'all';
    function apply() {
      var n = 0;
      cards.forEach(function (c) {
        var show = cur === 'all' || c.getAttribute('data-cat') === cur;
        c.style.display = show ? '' : 'none';
        if (show) n++;
      });
      if (empty) empty.style.display = n === 0 ? '' : 'none';
    }
    chips.forEach(function (ch) {
      ch.addEventListener('click', function () {
        cur = ch.getAttribute('data-cat');
        chips.forEach(function (x) { x.classList.toggle('active', x === ch); });
        apply();
      });
    });
  })();
</script>

</body>
</html>
